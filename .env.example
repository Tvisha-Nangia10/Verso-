# ── Supabase ─────────────────────────────────────────────────────
# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → publishable key (sb_publishable_…)
# Legacy projects: use the anon public key instead — both work.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ── Gemini (AI writing assistant + chatbot) ──────────────────────
# https://aistudio.google.com/apikey
# NOTE: anything with a VITE_ prefix is bundled into the client and is
# visible to users. Fine for a demo; for production move the Gemini call
# behind a Supabase Edge Function (see supabase/functions/gemini-chat).
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.0-flash

# Optional: route Gemini through a Supabase Edge Function so the key never
# reaches the browser. Deploy supabase/functions/gemini-chat, then set:
# VITE_GEMINI_PROXY_URL=https://your-project-ref.supabase.co/functions/v1/gemini-chat
